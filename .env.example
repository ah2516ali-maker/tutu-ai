# ---- TUTU AI Backend configuration ----
# Get your FREE API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Multimodal Gemini model (supports text + image input).
# Supported options include: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Server port (Android emulator expects http://10.0.2.2:5000)
PORT=5000

# Groq fallback provider (get a key from https://console.groq.com/keys)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-4-scout-17b-16e-instruct
